    nnoremap <buffer> <silent> gb :call <SID>Toggle()<CR>
    nnoremap <buffer> <silent> ? :call <SID>Help()<CR>
    " 内部测试钩子：VIMB_NO_AUTO_OPEN=1 时不自动打开 blame
    if $VIMB_NO_AUTO_OPEN !=# '1'
        call s:OpenBlame()
