" 内部测试钩子：等待所有后台 Git job 结束（带超时），无 job 时立即返回。
function! s:WaitJobs() abort
    let l:rounds = 0
    while !empty(s:jobs) && l:rounds < 1000
        sleep 10m
        let l:rounds += 1
    endwhile
endfunction
command! -bar VimbWait call <SID>WaitJobs()

